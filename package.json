{
	"name": "n8n-nodes-pipsync",
	"version": "0.1.0",
	"description": "Read-only n8n community node for the public PipSync API",
	"license": "MIT",
	"homepage": "https://github.com/pipsyncio/n8n-nodes-pipsync#readme",
	"author": {
		"name": "PipSync",
		"email": "support@pipsync.io",
		"url": "https://pipsync.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pipsyncio/n8n-nodes-pipsync.git"
	},
	"bugs": {
		"url": "https://github.com/pipsyncio/n8n-nodes-pipsync/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"pipsync",
		"trading-signals",
		"trade-reports",
		"workflow-automation",
		"read-only"
	],
	"engines": {
		"node": ">=22.22.0",
		"npm": ">=10"
	},
	"packageManager": "npm@11.8.0",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test test/*.test.cjs",
		"scan:credentials": "node scripts/credential-scan.mjs",
		"pack:check": "node scripts/pack-check.mjs",
		"verify": "npm run format:check && npm run lint && npm run build && npm test && npm run scan:credentials && npm run pack:check",
		"release": "n8n-node release",
		"prepack": "npm run build",
		"prepublishOnly": "n8n-node prerelease && npm run verify"
	},
	"files": [
		"dist/**/*.d.ts",
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/nodes/**/*.json",
		"dist/nodes/PipSync/*.svg",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PipSyncApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/PipSync/PipSync.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.45.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "21.1.2",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
